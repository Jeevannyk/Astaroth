<mxfile host="app.diagrams.net">
  <diagram id="astaroth" name="Astaroth architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- title -->
        <mxCell id="title" value="Astaroth: how it works" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="500" height="36" as="geometry" />
        </mxCell>

        <!-- clients -->
        <mxCell id="c1" value="kvdb CLI&lt;br&gt;put / get / del / batch / dump / check" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="kvdb serve&lt;br&gt;reads commands, prints ACK" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="125" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="torture tool&lt;br&gt;runs serve, kills it at random" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="195" width="230" height="50" as="geometry" />
        </mxCell>

        <!-- engine -->
        <mxCell id="e1" value="Engine (Go library)&lt;br&gt;Put · Get · Delete · Batch · Close" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- write path -->
        <mxCell id="wp0" value="Write path" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="195" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="1  Check key and value sizes" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="240" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="2  Take the write lock (lock 2)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="295" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="3  Disk-full check: does it fit under the max size?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="350" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="4  Build the frame with its CRC, write it at the end of the file" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="405" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="5  fsync (now it is safe on disk)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="460" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="w6" value="6  Update the in-memory index" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="515" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="w7" value="7  Unlock, return OK (serve prints ACK)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="570" width="250" height="42" as="geometry" />
        </mxCell>

        <!-- recovery -->
        <mxCell id="r0" value="Open / recovery" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="258" width="250" height="26" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="1  Take the file lock (lock 1)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="290" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="2  Remove or finish a half-done compaction" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="342" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="3  Check the file header" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="394" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="4  Read frames one by one, check each CRC, rebuild the index" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="446" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="5  Cut off a half-written last frame" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="498" width="250" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="6  Ready" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="550" width="250" height="42" as="geometry" />
        </mxCell>

        <!-- locks -->
        <mxCell id="l1" value="Lock 1: the [path].lock file&lt;br&gt;only one process can open the database" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="625" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="Lock 2: read/write lock in memory&lt;br&gt;only one write at a time" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="700" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- data file layout -->
        <mxCell id="f0" value="Data file layout (one file, little-endian)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="60" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="fh" value="header&lt;br&gt;32 bytes" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="95" width="110" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ff1" value="frame 1" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="95" width="100" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ff2" value="frame 2" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="95" width="100" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ff3" value="..." style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="95" width="80" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ff4" value="frame N" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="95" width="130" height="46" as="geometry" />
        </mxCell>
        <mxCell id="fnote" value="Every Put, Delete or whole Batch is one frame, added at the end. Only the last frame can be half-written by a crash." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="145" width="520" height="34" as="geometry" />
        </mxCell>

        <mxCell id="fr0" value="Inside one frame" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="185" width="300" height="26" as="geometry" />
        </mxCell>
        <mxCell id="fa" value="magic&lt;br&gt;4 B" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="215" width="70" height="52" as="geometry" />
        </mxCell>
        <mxCell id="fb" value="length&lt;br&gt;4 B" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="215" width="70" height="52" as="geometry" />
        </mxCell>
        <mxCell id="fc" value="seq&lt;br&gt;8 B" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="215" width="70" height="52" as="geometry" />
        </mxCell>
        <mxCell id="fd" value="op count&lt;br&gt;4 B" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="215" width="75" height="52" as="geometry" />
        </mxCell>
        <mxCell id="fe" value="records&lt;br&gt;N bytes" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="925" y="215" width="130" height="52" as="geometry" />
        </mxCell>
        <mxCell id="fg" value="CRC  4 B&lt;br&gt;(commit mark)" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1055" y="215" width="105" height="52" as="geometry" />
        </mxCell>
        <mxCell id="frec" value="Put record: type 1 · key length 2 · value length 4 · key · value&lt;br&gt;Delete record: type 1 · key length 2 · key" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="275" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fcrc" value="The CRC covers everything before it. A frame only counts if its CRC matches, so a half-written frame is ignored." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="520" height="44" as="geometry" />
        </mxCell>

        <mxCell id="fl" value="Data file on disk" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="405" width="260" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ix" value="In-memory index&lt;br&gt;key → position in the file&lt;br&gt;(rebuilt on open, not saved)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="480" width="240" height="62" as="geometry" />
        </mxCell>

        <!-- compaction -->
        <mxCell id="k0" value="Compaction (shrinks the file)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="565" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="k1" value="1  Write only live keys to a .compact.tmp file" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="95" height="100" as="geometry" />
        </mxCell>
        <mxCell id="k2" value="2  fsync the new file" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="747" y="600" width="95" height="100" as="geometry" />
        </mxCell>
        <mxCell id="k3" value="3  Read it back and verify it" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="854" y="600" width="95" height="100" as="geometry" />
        </mxCell>
        <mxCell id="k4" value="4  Rename it over the old file (one atomic step)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="961" y="600" width="95" height="100" as="geometry" />
        </mxCell>
        <mxCell id="k5" value="5  Reopen the file, swap the index" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1068" y="600" width="95" height="100" as="geometry" />
        </mxCell>
        <mxCell id="knote" value="Crash before step 4: the old file is still the database. Crash after: the new file is." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="712" width="520" height="34" as="geometry" />
        </mxCell>

        <!-- arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="c1" target="e1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="c2" target="e1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;dashed=1;" edge="1" parent="1" source="c3" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="e1" target="w1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="w2" target="w3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="w3" target="w4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="w4" target="w5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="w5" target="w6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="w6" target="w7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="w4" target="fl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="w6" target="ix"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="r5" target="r6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="k4" target="k5"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
